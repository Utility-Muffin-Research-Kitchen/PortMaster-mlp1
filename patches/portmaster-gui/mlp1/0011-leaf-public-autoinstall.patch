 ## Autoinstallation Code
 # This will automatically install zips found within the `PortMaster/autoinstall` / `ports/autoinstall` directory using harbourmaster
+# LEAF_PM_PUBLIC_AUTOINSTALL: use the manager-validated selected install source.
 AUTOINSTALL_DIR_1="$controlfolder/autoinstall"
-AUTOINSTALL_DIR_2="/$directory/ports/autoinstall"
+AUTOINSTALL_DIR_2="${HM_PORTS_DIR:-/$directory/ports}/autoinstall"
 
 if [ ! -d "$AUTOINSTALL_DIR_2" ]; then
   mkdir -p "$AUTOINSTALL_DIR_2"
 fi
 
+AUTOINSTALL_README="$AUTOINSTALL_DIR_2/README.txt"
+if [ ! -e "$AUTOINSTALL_README" ]; then
+  cat > "$AUTOINSTALL_README" <<'EOF'
+Copy PortMaster-format port ZIP files here without extracting them.
+Open PortMaster to install them.
+Successful ZIPs disappear; failed ZIPs remain here so you can retry.
+Third-party ports are supported by their authors, may require legally owned
+game data, and are not guaranteed to work on Leaf.
+With two cards, choose this card under Default Install Card in PortMaster.
+EOF
+fi
+
 # Check if there are any files to process before starting the dialog
 AUTOINSTALL_FILES=$(find "$AUTOINSTALL_DIR_1" "$AUTOINSTALL_DIR_2" -type f \( -name "*.zip" -o -name "*.squashfs" \) 2>/dev/null)
 
